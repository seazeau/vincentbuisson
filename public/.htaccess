# ======================================================================
# 1. REDIRECTION FORCÉE HTTPS & DOMAINE CANONIQUE (301 PERMANENTE)
# ======================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS pour tout le trafic non sécurisé
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forcer le domaine canonique sans www (vincentbuisson.fr)
  RewriteCond %{HTTP_HOST} ^www\.vincentbuisson\.fr$ [NC]
  RewriteRule ^(.*)$ https://vincentbuisson.fr/$1 [L,R=301]

  # Gestion des pages statiques Next.js (trailing slash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]
</IfModule>

# ======================================================================
# 2. SÉCURITÉ & EN-TÊTES HTTP
# ======================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ======================================================================
# 3. COMPRESSION GZIP / DEFLATE
# ======================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ======================================================================
# 4. MISE EN CACHE DU NAVIGATEUR (BROWSER CACHING)
# ======================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 1 hour"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images, Médias, Polices
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ======================================================================
# 5. PAGE D'ERREUR 404 PERSONNALISÉE
# ======================================================================
ErrorDocument 404 /_not-found/index.html
